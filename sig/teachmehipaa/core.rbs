module TeachMeHipaa
  VERSION: String

  type environment = :live | :sandbox
  type headers = Hash[String, String]
  type app_info = { name: String, ?version: String, ?url: String }

  ENVIRONMENTS: Hash[environment, String]
  DEFAULT_MAX_RETRIES: Integer
  DEFAULT_TIMEOUT: Float

  interface _Logger
    def info: (String message) -> untyped
  end

  interface _Clock
    def call: () -> Float
  end

  interface _Sleep
    def call: (Float seconds) -> untyped
  end

  interface _Transport
    def call: (Transport::Request request) -> Transport::Response
  end

  interface _TokenProvider
    def access_token: (Core::Connection connection) -> String
    def invalidate: (String access_token) -> void
  end

  class FieldError < Data
    attr_reader path: String
    attr_reader message: String

    def self.new: (path: String, message: String) -> instance
  end

  class Error < StandardError
    attr_reader status: Integer?
    attr_reader code: String?
    attr_reader title: String?
    attr_reader detail: String?
    attr_reader errors: Array[FieldError]
    attr_reader request_id: String?
    attr_reader headers: headers
    attr_reader body: String?

    def initialize: (String message, ?status: Integer?, ?code: String?, ?title: String?, ?detail: String?,
                     ?errors: Array[FieldError], ?request_id: String?, ?headers: headers, ?body: String?) -> void

    def self.from_response: (Transport::Response response) -> Error
    def self.from_oauth_response: (Transport::Response response) -> Error
  end

  class AuthenticationError < Error
  end

  class PermissionDeniedError < Error
  end

  class NotFoundError < Error
  end

  class ConflictError < Error
  end

  class PreconditionFailedError < Error
  end

  class InvalidRequestError < Error
  end

  class IdempotencyError < InvalidRequestError
  end

  class RateLimitError < Error
    def retry_after: () -> Float?
  end

  class APIError < Error
    def self.unexpected: (Transport::Response response) -> APIError
  end

  class OAuthError < Error
  end

  class APIConnectionError < Error
  end

  class APITimeoutError < APIConnectionError
  end

  module Transport
    class Request < Data
      attr_reader http_method: String
      attr_reader url: String
      attr_reader headers: headers
      attr_reader body: String?
      attr_reader timeout: Float

      def self.new: (http_method: String, url: String, headers: headers, body: String?, timeout: Float) -> instance
    end

    class Response < Data
      attr_reader status: Integer
      attr_reader headers: headers
      attr_reader body: String

      def self.new: (status: Integer, headers: headers, body: String) -> instance
    end

    class NetHttp
      include _Transport
    end
  end

  class Config < Data
    attr_reader environment: environment
    attr_reader base_url: String
    attr_reader organization_id: String?
    attr_reader max_retries: Integer
    attr_reader timeout: Float
    attr_reader user_agent: String
    attr_reader logger: _Logger?
    attr_reader clock: _Clock
    attr_reader sleep: _Sleep

    def self.build: (environment: environment | String, base_url: String?, organization_id: String?,
                     max_retries: Integer, timeout: Numeric, app_info: app_info?, logger: _Logger?,
                     clock: _Clock?, sleep: _Sleep?) -> Config
    def self.check_max_retries: (untyped max_retries) -> Integer
    def self.check_timeout: (untyped timeout) -> Float
  end

  class LastResponse < Data
    attr_reader status: Integer
    attr_reader headers: headers

    def self.from: (Transport::Response response) -> LastResponse
    def request_id: () -> String?
    def etag: () -> String?
  end

  class Model
    def self.fields: () -> Hash[Symbol, untyped]

    attr_reader last_response: LastResponse?

    def initialize: (Hash[String, untyped] data, ?last_response: LastResponse?) -> void
    def []: (String | Symbol key) -> untyped
    def to_h: () -> Hash[Symbol, untyped]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
  end

  module TokenProviders
    REFRESH_MARGIN_SECONDS: Integer

    class ClientCredentials
      include _TokenProvider

      def initialize: (client_id: String, client_secret: String, ?scopes: Array[String | Symbol]?) -> void
    end
  end

  type request_options = {
    ?headers: Hash[String, String],
    ?timeout: Numeric,
    ?max_retries: Integer,
    ?idempotency_key: String
  }

  # @api private
  module Core
    module Json
      def self.success_body: (Transport::Response response) -> untyped
      def self.object_body: (Transport::Response response) -> Hash[String, untyped]?
      def self.json?: (String? content_type) -> bool
      def self.retry_after: (headers headers) -> Float?
    end

    # The keyword arguments of Connection#request.
    type request = {
      method: String,
      path: String,
      ?query: Hash[Symbol | String, untyped],
      headers: Hash[String, String],
      ?body: String?,
      ?timeout: Numeric?
    }

    module Retries
      INITIAL_DELAY: Float
      MAX_DELAY: Float
      MAX_RETRY_AFTER: Float

      class Policy < Data
        attr_reader retry_safe: bool
        attr_reader max_retries: Integer

        def self.new: (retry_safe: bool, max_retries: Integer) -> instance
      end

      interface _ErrorMapper
        def call: (Transport::Response response) -> Error
      end

      interface _Replay
        def call: (request refused) -> void
      end

      def self.call: (Connection connection, Policy policy, map_error: _ErrorMapper,
                      ?replay: _Replay?) { () -> request } -> Transport::Response
    end

    class Connection
      NETWORK_ERRORS: Array[singleton(StandardError)]

      attr_reader config: Config

      def initialize: (Config config, _Transport transport) -> void
      def request: (method: String, path: String, ?query: Hash[Symbol | String, untyped],
                    ?headers: Hash[String, String], ?body: String?, ?timeout: Numeric?) -> Transport::Response
    end

    class Requestor
      REQUEST_OPTIONS: Array[Symbol]
      NEVER_RETRIED: Array[String]

      def initialize: (Connection connection, _TokenProvider token_provider) -> void
      def request: [M < Model] (method: String, path: String, model: _ModelClass[M],
                                ?path_params: Hash[Symbol | String, String],
                                ?query: Hash[Symbol | String, untyped],
                                ?headers: Hash[String, String],
                                ?body: Hash[String, untyped]?,
                                ?content_type: String,
                                ?retry_safe: bool,
                                ?idempotency_key: (:required | nil),
                                ?request_options: request_options) -> M
    end

    interface _ModelClass[M]
      def new: (Hash[String, untyped] data, ?last_response: LastResponse?) -> M
    end

    class Resource
      def initialize: (Requestor requestor) -> void
    end
  end

  class Client
    include Resources::Root

    attr_reader config: Config

    def initialize: (client_id: String, client_secret: String, ?environment: environment | String,
                     ?base_url: String?, ?organization_id: String?, ?scopes: Array[String | Symbol]?,
                     ?max_retries: Integer, ?timeout: Numeric, ?transport: _Transport?,
                     ?logger: _Logger?, ?app_info: app_info?, ?clock: _Clock?, ?sleep: _Sleep?) -> void

    def environment: () -> environment
    def base_url: () -> String
    def max_retries: () -> Integer
    def timeout: () -> Float
  end
end
